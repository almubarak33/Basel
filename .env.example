# ─── Django ───────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-strong-random-key

DEBUG=False

# Comma-separated list of allowed hosts (your domain or IP)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=sayhi_db
DB_USER=postgres
DB_PASSWORD=change-me-strong-db-password
DB_HOST=db
DB_PORT=5432

# ─── Redis (WebSocket channel layer) ──────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Add your frontend URL(s) — comma separated
CORS_ALLOWED_ORIGINS=http://localhost,https://yourdomain.com

# ─── Frontend URL (used in password-reset emails) ─────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ─── Email (for password reset) ───────────────────────────────────────────────
# Leave EMAIL_BACKEND as console for local dev (prints emails to terminal)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=SayHi <noreply@yourdomain.com>

# ─── React (build-time env vars — prefix with REACT_APP_) ────────────────────
# Backend API URL seen from the browser
REACT_APP_API_URL=http://localhost/api
# WebSocket host (host:port without protocol)
REACT_APP_WS_HOST=localhost
